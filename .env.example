DB_NAME=hackathon_db
DB_PORT=5432
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/hackathon_db?schema=public"

# Application Ports
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# API Endpoint
VITE_API_URL=/api
